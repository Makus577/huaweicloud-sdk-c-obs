#
# Copyright (c) Huawei Technologies Co., Ltd. 2024. All rights reserved.
#
# Unified Makefile for GM + Mutual Authentication Test Scenarios
# 国密+双向认证测试场景统一编译文件
#
# 使用方法:
#   make scenario1    - 编译场景1
#   make scenario2    - 编译场景2
#   make scenario3    - 编译场景3
#   make scenario4    - 编译场景4
#   make all          - 编译所有场景
#   make run1         - 编译并运行场景1
#   make clean        - 清理编译结果
#

#==============================================================================
# 编译器配置
#==============================================================================
CC = gcc
CFLAGS = -Wall -g -O0 -std=c11
INCLUDES = -I. -I../inc

#==============================================================================
# 库配置
#==============================================================================
LIBS = -lssl -lcrypto -lpthread

#==============================================================================
# 输出目录
#==============================================================================
BUILD_DIR = build
BIN_DIR = $(BUILD_DIR)/bin

#==============================================================================
# 测试框架源文件
#==============================================================================
TEST_FRAMEWORK_SRC = ssl_gm_test_framework.c

#==============================================================================
# 场景源文件和目标
#==============================================================================

# 场景1: 标准TLS双向认证
SCENARIO1_SRC = test_scenario_1_standard_tls.c
SCENARIO1_BIN = $(BIN_DIR)/test_scenario_1_standard_tls

# 场景2: 国密单向认证
SCENARIO2_SRC = test_scenario_2_gm_one_way.c
SCENARIO2_BIN = $(BIN_DIR)/test_scenario_2_gm_one_way

# 场景3: 国密双向双证书
SCENARIO3_SRC = test_scenario_3_gm_mutual_dual_cert.c
SCENARIO3_BIN = $(BIN_DIR)/test_scenario_3_gm_mutual_dual_cert

# 场景4: 国密密码套件配置
SCENARIO4_SRC = test_scenario_4_gm_cipher_suite.c
SCENARIO4_BIN = $(BIN_DIR)/test_scenario_4_gm_cipher_suite

# 所有场景
ALL_SCENARIOS = $(SCENARIO1_BIN) $(SCENARIO2_BIN) $(SCENARIO3_BIN) $(SCENARIO4_BIN)

#==============================================================================
# 默认目标
#==============================================================================
.PHONY: default
default: help

#==============================================================================
# 帮助信息
#==============================================================================
.PHONY: help
help:
	@echo "=============================================================================="
	@echo "  国密+双向认证测试场景编译系统"
	@echo "  GM + Mutual Authentication Test Build System"
	@echo "=============================================================================="
	@echo ""
	@echo "【编译命令】"
	@echo "  make scenario1    编译场景1: 标准TLS双向认证"
	@echo "  make scenario2    编译场景2: 国密单向认证"
	@echo "  make scenario3    编译场景3: 国密双向双证书"
	@echo "  make scenario4    编译场景4: 国密密码套件配置"
	@echo "  make all          编译所有场景"
	@echo ""
	@echo "【运行命令】"
	@echo "  make run1         编译并运行场景1"
	@echo "  make run2         编译并运行场景2"
	@echo "  make run3         编译并运行场景3"
	@echo "  make run4         编译并运行场景4"
	@echo "  make run-all      编译并运行所有场景"
	@echo ""
	@echo "【清理命令】"
	@echo "  make clean        删除编译生成的文件"
	@echo "  make clean-all    深度清理(包括build目录)"
	@echo ""
	@echo "【其他命令】"
	@echo "  make help         显示此帮助信息"
	@echo "  make check        检查编译环境"
	@echo "  make list         列出所有场景"
	@echo "=============================================================================="

#==============================================================================
# 创建目录
#==============================================================================
$(BIN_DIR):
	@mkdir -p $@

#==============================================================================
# 场景编译目标
#==============================================================================

# 场景1: 标准TLS双向认证
.PHONY: scenario1
scenario1: $(SCENARIO1_BIN)
	@echo "场景1编译完成: $<"

$(SCENARIO1_BIN): $(SCENARIO1_SRC) $(TEST_FRAMEWORK_SRC) | $(BIN_DIR)
	@echo "编译场景1: 标准TLS双向认证..."
	$(CC) $(CFLAGS) $(INCLUDES) $^ -o $@ $(LIBS)
	@echo "场景1编译成功!"

# 场景2: 国密单向认证
.PHONY: scenario2
scenario2: $(SCENARIO2_BIN)
	@echo "场景2编译完成: $<"

$(SCENARIO2_BIN): $(SCENARIO2_SRC) $(TEST_FRAMEWORK_SRC) | $(BIN_DIR)
	@echo "编译场景2: 国密单向认证..."
	$(CC) $(CFLAGS) $(INCLUDES) $^ -o $@ $(LIBS)
	@echo "场景2编译成功!"

# 场景3: 国密双向双证书
.PHONY: scenario3
scenario3: $(SCENARIO3_BIN)
	@echo "场景3编译完成: $<"

$(SCENARIO3_BIN): $(SCENARIO3_SRC) $(TEST_FRAMEWORK_SRC) | $(BIN_DIR)
	@echo "编译场景3: 国密双向双证书..."
	$(CC) $(CFLAGS) $(INCLUDES) $^ -o $@ $(LIBS)
	@echo "场景3编译成功!"

# 场景4: 国密密码套件配置
.PHONY: scenario4
scenario4: $(SCENARIO4_BIN)
	@echo "场景4编译完成: $<"

$(SCENARIO4_BIN): $(SCENARIO4_SRC) $(TEST_FRAMEWORK_SRC) | $(BIN_DIR)
	@echo "编译场景4: 国密密码套件配置..."
	$(CC) $(CFLAGS) $(INCLUDES) $^ -o $@ $(LIBS)
	@echo "场景4编译成功!"

# 编译所有场景
.PHONY: all
all: $(ALL_SCENARIOS)
	@echo "=============================================================================="
	@echo "  所有场景编译完成!"
	@echo "  可执行文件位置: $(BIN_DIR)/"
	@echo "=============================================================================="
	@ls -lh $(BIN_DIR)/

#==============================================================================
# 运行目标
#==============================================================================

.PHONY: run1
run1: scenario1
	@echo ""
	@echo "========================================"
	@echo "  运行场景1: 标准TLS双向认证测试"
	@echo "========================================"
	@echo ""
	$(SCENARIO1_BIN)

.PHONY: run2
run2: scenario2
	@echo ""
	@echo "========================================"
	@echo "  运行场景2: 国密单向认证测试"
	@echo "========================================"
	@echo ""
	$(SCENARIO2_BIN)

.PHONY: run3
run3: scenario3
	@echo ""
	@echo "========================================"
	@echo "  运行场景3: 国密双向双证书测试"
	@echo "========================================"
	@echo ""
	$(SCENARIO3_BIN)

.PHONY: run4
run4: scenario4
	@echo ""
	@echo "========================================"
	@echo "  运行场景4: 国密密码套件配置测试"
	@echo "========================================"
	@echo ""
	$(SCENARIO4_BIN)

.PHONY: run-all
run-all: all
	@echo "=============================================================================="
	@echo "  运行所有测试场景"
	@echo "=============================================================================="
	@echo ""
	@$(MAKE) run1
	@echo ""
	@$(MAKE) run2
	@echo ""
	@$(MAKE) run3
	@echo ""
	@$(MAKE) run4
	@echo ""
	@echo "=============================================================================="
	@echo "  所有测试场景执行完成"
	@echo "=============================================================================="

#==============================================================================
# 清理目标
#==============================================================================

.PHONY: clean
clean:
	@echo "清理编译生成的文件..."
	@rm -rf $(BUILD_DIR)
	@echo "清理完成!"

.PHONY: clean-all
clean-all: clean
	@echo "深度清理完成!"

#==============================================================================
# 实用工具目标
#==============================================================================

# 检查编译环境
.PHONY: check
check:
	@echo "=============================================================================="
	@echo "  编译环境检查"
	@echo "=============================================================================="
	@echo ""
	@echo "检查 GCC 编译器..."
	@$(CC) --version 2>/dev/null | head -1 || echo "  [错误] GCC未安装"
	@echo ""
	@echo "检查 OpenSSL 库..."
	@pkg-config --modversion openssl 2>/dev/null || echo "  [警告] 无法获取OpenSSL版本"
	@echo ""
	@echo "检查头文件..."
	@test -f ../inc/eSDKOBS.h && echo "  [OK] eSDKOBS.h" || echo "  [MISSING] eSDKOBS.h"
	@test -f ssl_gm_test_framework.h && echo "  [OK] ssl_gm_test_framework.h" || echo "  [MISSING] ssl_gm_test_framework.h"
	@echo ""
	@echo "检查测试源文件..."
	@test -f $(SCENARIO1_SRC) && echo "  [OK] $(SCENARIO1_SRC)" || echo "  [MISSING] $(SCENARIO1_SRC)"
	@test -f $(SCENARIO2_SRC) && echo "  [OK] $(SCENARIO2_SRC)" || echo "  [MISSING] $(SCENARIO2_SRC)"
	@test -f $(SCENARIO3_SRC) && echo "  [OK] $(SCENARIO3_SRC)" || echo "  [MISSING] $(SCENARIO3_SRC)"
	@test -f $(SCENARIO4_SRC) && echo "  [OK] $(SCENARIO4_SRC)" || echo "  [MISSING] $(SCENARIO4_SRC)"
	@echo ""
	@echo "=============================================================================="
	@echo "  环境检查完成"
	@echo "=============================================================================="

# 列出所有场景
.PHONY: list
list:
	@echo "=============================================================================="
	@echo "  测试场景列表"
	@echo "=============================================================================="
	@echo ""
	@echo "场景1: 标准TLS双向认证测试"
	@echo "  源文件: $(SCENARIO1_SRC)"
	@echo "  目标:   $(SCENARIO1_BIN)"
	@echo "  命令:   make scenario1 或 make run1"
	@echo ""
	@echo "场景2: 国密单向认证测试"
	@echo "  源文件: $(SCENARIO2_SRC)"
	@echo "  目标:   $(SCENARIO2_BIN)"
	@echo "  命令:   make scenario2 或 make run2"
	@echo ""
	@echo "场景3: 国密双向双证书测试"
	@echo "  源文件: $(SCENARIO3_SRC)"
	@echo "  目标:   $(SCENARIO3_BIN)"
	@echo "  命令:   make scenario3 或 make run3"
	@echo ""
	@echo "场景4: 国密密码套件配置测试"
	@echo "  源文件: $(SCENARIO4_SRC)"
	@echo "  目标:   $(SCENARIO4_BIN)"
	@echo "  命令:   make scenario4 或 make run4"
	@echo ""
	@echo "=============================================================================="
	@echo "  批量操作命令"
	@echo "=============================================================================="
	@echo "  make all       - 编译所有场景"
	@echo "  make run-all   - 编译并运行所有场景"
	@echo "  make clean     - 清理编译结果"
	@echo "  make check     - 检查编译环境"
	@echo "=============================================================================="
